      A2: { x: 37, y: 45, w: 88 },
      A3: { x: 26, y: 66, w: 98 },
      A4: { x: 12, y: 88, w: 106 },
      A5: { x: 39, y: 90, w: 106 },
      E1: { x: 77, y: 52, w: 152 },
      E2: { x: 63, y: 86, w: 112 },
      E3: { x: 87, y: 88, w: 112 },
      BOSS: { x: 73, y: 78, w: 206 }
    };

    this.QSEQ = ['knight','nature','light','dark','wild','dragon','light','nature','dragon','dark','knight','wild','capsule','nature','light','dragon','dark','knight'];
    this._uid = 0;
    this.state = this.initial();
  }

  initial() {
    const layout = ['dragon','knight','nature','light','dark','wild','capsule','dragon','knight','nature','wild','light'];
    return {
      slots: layout.map((e) => this.mk(e)),
      qp: 0, sel: [], target: 0,
      teamHp: 2840, teamMax: 3200,
      round: 3, roundMax: 3,
      leaderOn: false, leaderCd: 0,
      toast: '', toastOn: false, toastTone: 'amber', popOn: false,
      allies: [
        { slot: 'A1', elem: 'dragon', lv: 38, skill: 45 },
        { slot: 'A2', elem: 'dark',   lv: 38, skill: 30 },
        { slot: 'A3', elem: 'knight', lv: 38, skill: 55 },
        { slot: 'A4', elem: 'light',  lv: 38, skill: 30 },
        { slot: 'A5', elem: 'nature', lv: 38, skill: 30 }
      ],
      enemies: [
        { slot: 'E1', name: 'Long Ear Guardian', elem: 'light', lv: 40, hp: 1850, max: 4000, dmg: 220, atk: 2, atkMax: 3, alive: true },
        { slot: 'E2', name: 'Dusk Dragon',    elem: 'dark', lv: 36, hp: 1200, max: 1200, dmg: 130, atk: 1, atkMax: 3, alive: true },
        { slot: 'E3', name: 'Twin Tail',      elem: 'nature', lv: 36, hp: 1400, max: 1400, dmg: 150, atk: 3, atkMax: 3, alive: true }
      ]
    };
  }

  mk(elem) { return { elem, num: this.POW[elem], key: elem + '-' + (++this._uid) }; }
  px(p, total) { return Math.round(p / 100 * total); }
  slotOf(e, solo) { return (solo && e.slot === 'E1') ? this.POS.BOSS : this.POS[e.slot]; }

  flash(msg, tone) {
    this.setState({ toast: msg, toastOn: true, toastTone: tone || 'amber' });
    clearTimeout(this._t);
    this._t = setTimeout(() => this.setState({ toastOn: false }), 1900);
  }

  pick(i) {
    const sel = this.state.sel.slice();
    const at = sel.indexOf(i);
    if (at >= 0) { sel.splice(at, 1); this.setState({ sel }); return; }
    if (sel.length >= 3) return;
    sel.push(i);
    this.setState({ sel });
    if (sel.length === 3) setTimeout(() => this.resolve(), 280);
  }

  tick(enemies) {
    let dmg = 0; const hits = [];
    enemies.forEach((e) => {
      if (!e.alive) return;
      e.atk -= 1;
      if (e.atk <= 0) { dmg += e.dmg; hits.push(e.name); e.atk = e.atkMax; }
    });
    return { dmg, hits };
  }

  resolve() {
    const S = this.state;
    if (S.sel.length !== 3) return;
    const used = S.sel.slice();
    const cs = used.map((i) => S.slots[i]);
    const caps = cs.filter((c) => c.elem === 'capsule').length;
    const sum = cs.reduce((a, c) => a + c.num, 0);

    if (caps > 0 && caps < 3) { this.flash('COMBO INVÁLIDO · CAPSULE NÃO MISTURA', 'red'); this.setState({ sel: [] }); return; }

    const patch = {};
    const enemies = S.enemies.map((e) => ({ ...e }));

    if (caps === 3) {
      const heal = sum * 35;
      patch.teamHp = Math.min(S.teamMax, S.teamHp + heal);
      this.flash('CURA +' + heal, 'mint');
    } else {
      const els = Array.from(new Set(cs.filter((c) => c.elem !== 'wild').map((c) => c.elem)));
      if (els.length > 1) { this.flash('COMBO INVÁLIDO · ELEMENTOS DIFERENTES', 'red'); this.setState({ sel: [] }); return; }
      const el = els[0] || S.allies[0].elem;
      let dmg = sum * 20;
      if (S.leaderOn) dmg = Math.round(dmg * 1.25);

      let t = S.target, rem = dmg;
      while (rem > 0) {
        const e = enemies[t];
        if (e && e.alive) {
          const d = Math.min(e.hp, rem); e.hp -= d; rem -= d;
          if (e.hp <= 0) { e.hp = 0; e.alive = false; }
        }
        if (rem > 0) { const nx = enemies.findIndex((x, j) => j !== t && x.alive); if (nx < 0) break; t = nx; }
        else break;
      }
      patch.leaderOn = false;
      patch.leaderCd = S.leaderOn ? 3 : Math.max(0, S.leaderCd - 1);
      if (!enemies[S.target].alive) { const nx = enemies.findIndex((x) => x.alive); patch.target = nx < 0 ? S.target : nx; }

      const allies = S.allies.map((a) => ({ ...a }));
      const ai = allies.findIndex((a) => a.elem === el);
      if (ai >= 0) allies[ai].skill = Math.min(100, allies[ai].skill + 34);
      patch.allies = allies;

      this.flash('DANO ' + dmg + ' · ' + el.toUpperCase(), 'amber');
    }

    const res = this.tick(enemies);
    const base = (patch.teamHp != null ? patch.teamHp : S.teamHp);
    patch.teamHp = Math.max(0, base - res.dmg);
    patch.enemies = enemies;

    const slots = S.slots.slice();
    let qp = S.qp;
    used.forEach((i) => { slots[i] = this.mk(this.QSEQ[qp % this.QSEQ.length]); qp++; });
    patch.slots = slots; patch.qp = qp; patch.sel = [];

    this.setState(patch, () => {
      if (this.state.enemies.every((e) => !e.alive)) { this.flash('VITÓRIA · SETOR LIMPO', 'mint'); return; }
      if (this.state.teamHp <= 0) { this.flash('DERROTA · EQUIPE CAÍDA', 'red'); return; }
      if (res.hits.length) setTimeout(() => this.flash(res.hits.join(' + ').toUpperCase() + ' ATACOU · -' + res.dmg, 'red'), 950);
    });
  }

  target(i) {
    const S = this.state;
    const e = S.enemies[i];
    if (!e || !e.alive) { this.flash('ALVO ABATIDO', 'red'); return; }
    if (S.target === i && S.popOn) { this.setState({ popOn: false }); return; }
    this.setState({ target: i, popOn: true });
  }

  ally(i) {
    const S = this.state;
    const a = S.allies[i];
    if (a.skill < 100) { this.flash('SKILL ' + a.elem.toUpperCase() + ' ' + a.skill + '%', 'amber'); return; }
    const enemies = S.enemies.map((e) => ({ ...e }));
    const t = enemies[S.target].alive ? S.target : enemies.findIndex((x) => x.alive);
    if (t >= 0) {
      enemies[t].hp = Math.max(0, enemies[t].hp - 600);
      if (enemies[t].hp === 0) enemies[t].alive = false;
    }
    const allies = S.allies.map((x) => ({ ...x }));
    allies[i].skill = 0;
    this.setState({ enemies, allies });
    this.flash('SKILL ' + a.elem.toUpperCase() + ' · -600', 'amber');
  }

  crown() {
    const S = this.state;
    if (S.leaderCd > 0) { this.flash('LIDERANÇA RECARREGA · ' + S.leaderCd, 'red'); return; }
    const on = !S.leaderOn;
    this.setState({ leaderOn: on });
    this.flash(on ? 'LIDERANÇA ATIVA · +25% NESTE TURNO' : 'LIDERANÇA CANCELADA', 'amber');
  }

  nav(label) {
    if (label === 'FASES') { this.setState(this.initial()); this.flash('FASES · NOVA PARTIDA', 'amber'); return; }
    this.flash(label + ' · TELA RESERVADA', 'amber');
  }

  renderVals() {
    const S = this.state;
    const solo = this.props.soloBoss ?? false;
    const FAINT = 'rgba(242,163,60,.18)';
    const PLATE_A = 27, PLATE_E = 19;
    const ind = this.props.indicador ?? 'anel';
    const ringOf = (w, fy, pct, col, glow) => {
      const rx = Math.round(w * .34), ry = Math.round(w * .34 * .3);
      return { rx, ry, rcx: rx + 6, rcy: ry + 6, rl: (w / 2 - rx - 6) + 'px', rt: (Math.round(w * .97) - ry - 6) + 'px',
        rw: (2 * rx + 12) + 'px', rh: (2 * ry + 12) + 'px', rcol: col, dash: pct + ' 100',
        rglow: glow ? 'drop-shadow(0 0 5px ' + col + ')' : 'none', ring: ind === 'anel', plain: ind !== 'anel' };
    };
    const badgeOf = (el) => 'radial-gradient(circle at 34% 28%, ' + this.LT[el] + ', ' + this.UI[el] + ')';
    const fillOf = (el) => 'linear-gradient(180deg, ' + this.LT[el] + ' 0%, ' + this.UI[el] + ' 52%, ' + this.DK[el] + ' 100%)';

    const cards = S.slots.map((c, i) => {
      const on = S.sel.indexOf(i);
      const E = this.EMB[c.elem];
      return {
        key: c.key, num: c.num, is_dragon: c.elem === 'dragon', is_knight: c.elem === 'knight', is_nature: c.elem === 'nature', is_light: c.elem === 'light', is_dark: c.elem === 'dark', is_capsule: c.elem === 'capsule', is_wild: c.elem === 'wild',
        d: E[0], d2: E[1], d2f: E[2], grad: E[3],
        rot: c.elem === 'capsule' ? 'rotate(-45 50 50)' : 'rotate(0 50 50)',
        selected: on >= 0, order: on + 1,
        pick: () => this.pick(i),
        frame: on >= 0
          ? 'box-shadow: 0 0 0 2.5px #F2A33C, 0 0 18px rgba(242,163,60,.6), 0 8px 14px rgba(0,0,0,.55); transform: translateY(-5px);'
          : 'box-shadow: 0 3px 7px rgba(0,0,0,.5);'
      };
    });

    const turnOf = (atk) => {
      if (atk >= 3) return { c: 'rgba(242,163,60,.75)', s: 'rgba(242,163,60,.55)', a: 'none' };
      if (atk === 2) return { c: '#F2A33C', s: '#F2A33C', a: 'none' };
      return { c: '#FF6B4A', s: '#FF6B4A', a: 'fast .8s ease-in-out infinite' };
    };

    // figuras no palco (aliados + inimigos vivos)
    const figs = [];
    const flags = (slot) => ({ is_A1: slot === 'A1', is_A2: slot === 'A2', is_A3: slot === 'A3', is_A4: slot === 'A4', is_A5: slot === 'A5',
      is_E1: slot === 'E1', is_E2: slot === 'E2', is_E3: slot === 'E3', is_BOSS: slot === 'BOSS' });
    S.allies.forEach((a) => {
      const p = this.POS[a.slot];
      figs.push({ key: a.slot, id: a.slot, x: p.x + '%', top: (this.px(p.y, this.H) - Math.round(p.w * 0.97)) + 'px', w: p.w + 'px',
        op: '1', fx: 'none', ...flags(a.slot), ...ringOf(p.w, 0, a.skill, this.UI[a.elem], a.skill >= 100) });
    });
    S.enemies.forEach((e) => {
      if (solo && e.slot !== 'E1') return;
      const p = this.slotOf(e, solo);
      const slot = solo ? 'BOSS' : e.slot;
      figs.push({ key: slot, id: slot, x: p.x + '%', top: (this.px(p.y, this.H) - Math.round(p.w * 0.97)) + 'px', w: p.w + 'px',
        op: e.alive ? '1' : '0.35', fx: e.alive ? 'none' : 'grayscale(1)', ...flags(slot),
        ...ringOf(p.w, 0, Math.round(e.hp / e.max * 100), '#FF4A3A', false) });
    });

    const allies = S.allies.map((a, i) => {
      const p = this.POS[a.slot];
      const h = Math.round(p.w * 0.97);
      const ready = a.skill >= 100;
      return {
        key: a.slot, lv: a.lv, pct: a.skill + '%', color: this.UI[a.elem], icon: this.ICON[a.elem],
        badge: badgeOf(a.elem), fill: fillOf(a.elem),
        x: p.x + '%', top: (this.px(p.y, this.H) - h) + 'px', hit: (h + PLATE_A) + 'px',
        hitW: Math.round(p.w * .62) + 'px', hitH: Math.round(h * .9) + 'px', ready,
        chipTop: (this.px(p.y, this.H) + Math.round(p.w * .34 * .3) + 1) + 'px',
        chipFrame: ready ? 'box-shadow: 0 0 0 1.3px #F2A33C, 0 0 10px rgba(242,163,60,.6);' : '',
        plateTop: (this.px(p.y, this.H) + 2) + 'px',
        miniTop: (this.px(p.y, this.H) + 3) + 'px', miniW: Math.round(p.w * .5) + 'px',
        miniGlow: ready ? 'filter: drop-shadow(0 0 4px ' + this.UI[a.elem] + ');' : '',
        tag: ready ? 'PRONTA' : 'SKILL',
        tagcol: ready ? '#F2A33C' : 'rgba(255,255,255,.62)',
        frame: ready ? 'box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 0 0 1.3px #F2A33C, 0 0 12px rgba(242,163,60,.55);' : '',
        glow: ready ? 'box-shadow: inset 0 1px 2px rgba(0,0,0,.9), 0 0 0 1px rgba(242,163,60,.9), 0 0 8px rgba(242,163,60,.6);' : '',
        pick: () => this.ally(i)
      };
    });

    const enemies = S.enemies.map((e, i) => {
      const p = this.slotOf(e, solo);
      const h = Math.round(p.w * 0.97);
      const isT = S.target === i && e.alive;
      return {
        key: e.slot, lv: e.lv, atk: e.atk, color: this.UI[e.elem], icon: this.ICON[e.elem],
        badge: badgeOf(e.elem),
        x: p.x + '%', top: (this.px(p.y, this.H) - h) + 'px', hit: (h + PLATE_E) + 'px',
        hitW: Math.round(p.w * .62) + 'px', hitH: Math.round(h * .9) + 'px',
        show: (solo && e.slot !== 'E1') ? 'none' : 'block', showFlex: (solo && e.slot !== 'E1') ? 'none' : 'flex',
        chipTop: (this.px(p.y, this.H) + Math.round(p.w * .34 * .3) + 1) + 'px',
        chipFrame: isT ? 'box-shadow: 0 0 0 1.3px #FF6B4A, 0 0 10px rgba(255,107,74,.55);' : '',
        plateTop: (this.px(p.y, this.H) + 2) + 'px',
        miniTop: (this.px(p.y, this.H) + 3) + 'px', miniW: Math.round(p.w * .5) + 'px',
        tcol: e.alive ? turnOf(e.atk).c : 'rgba(245,239,226,.3)', tanim: e.alive ? turnOf(e.atk).a : 'none',
        s1: e.atk >= 1 ? turnOf(e.atk).s : FAINT, s2: e.atk >= 2 ? turnOf(e.atk).s : FAINT, s3: e.atk >= 3 ? turnOf(e.atk).s : FAINT,
        pct: Math.round(e.hp / e.max * 100) + '%',
        dim: (solo && e.slot !== 'E1') ? '0' : (e.alive ? '1' : '0.35'),
        warn: e.alive && e.atk <= 1,
        frame: isT ? 'box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 0 0 1.4px #FF6B4A, 0 0 12px rgba(255,107,74,.6);' : '',
        pick: () => this.target(i)
      };
    });

    const fila = Array.from({ length: 4 }, (_, k) => {
      const el = this.QSEQ[(S.qp + k) % this.QSEQ.length];
      return { key: 'f' + k, is_dragon: el === 'dragon', is_knight: el === 'knight', is_nature: el === 'nature', is_light: el === 'light', is_dark: el === 'dark', is_capsule: el === 'capsule', is_wild: el === 'wild', op: (1 - k * 0.2).toFixed(2) };
    });

    // alvo + pop-up ancorado acima dele
    const alvo = S.enemies[S.target] || S.enemies[0];
    const ap = this.slotOf(alvo, solo);
    const ah = Math.round(ap.w * 0.97);
    const apxX = this.px(ap.x, this.W);
    const apxTop = this.px(ap.y, this.H) - ah;
    const at = turnOf(alvo.atk);
    const popW = 172;
    const clampX = Math.max(popW / 2 + 6, Math.min(this.W - popW / 2 - 6, apxX));
    const popH = 74;
    const head = apxTop + Math.round(ap.w * .12);
    const above = head - popH - 12 > 26;
    const popLeft = above ? clampX : Math.max(popW / 2 + 6, apxX - Math.round(ap.w * .38) - popW / 2 - 8);
    const popTop = above ? head - popH - 10 : 28;
    const popArrow = above
      ? 'left: 50%; bottom: -5px; transform: translateX(-50%) rotate(45deg); box-shadow: 1px 1px 0 0 rgba(255,107,74,.5);'
      : 'right: -5px; top: 30px; transform: rotate(45deg); box-shadow: 1px -1px 0 0 rgba(255,107,74,.5);';

    const teamRatio = S.teamHp / S.teamMax;
    const teamCol = teamRatio > 0.4 ? '#6FE3B8' : (teamRatio > 0.2 ? '#F2A33C' : '#FF6B4A');
    const tones = { amber: '#F2A33C', red: '#FF6B4A', mint: '#6FE3B8' };

    return {
      cards, enemies, allies, fila, figs,
      showSlots: this.props.showSlots ?? false,
      bgTropical: (this.props.cenario ?? 'tropical') === 'tropical',
      bgDeserto: this.props.cenario === 'deserto',
      bgVetor: this.props.cenario === 'vetor',
      round: S.round, roundMax: S.roundMax,
      aimX: apxX + 'px', aimY: (apxTop + ah / 2) + 'px', aimS: Math.round(ah * 0.96) + 'px',
      popX: popLeft + 'px', popY: popTop + 'px', popArrow, popOn: S.popOn && alvo.alive,
      indAnel: ind === 'anel', indMinimo: ind === 'minimo', indPlaca: ind === 'placa',
      alvoNome: alvo.name, alvoLv: alvo.lv, alvoHp: alvo.hp, alvoMax: alvo.max, alvoAtk: alvo.atk,
      alvoPct: Math.round(alvo.hp / alvo.max * 100) + '%',
      alvoTcol: at.c, alvoTanim: at.a,
      alvoS1: alvo.atk >= 1 ? at.s : FAINT,
      alvoS2: alvo.atk >= 2 ? at.s : FAINT,
      alvoS3: alvo.atk >= 3 ? at.s : FAINT,
      teamHp: S.teamHp, teamMax: S.teamMax, teamCol,
      teamPct: Math.round(teamRatio * 100) + '%',
      crown: () => this.crown(),
      crownTag: S.leaderOn ? 'LÍDER ON' : (S.leaderCd > 0 ? 'CD ' + S.leaderCd : 'LÍDER'),
      crownCol: S.leaderOn ? '#1A1105' : (S.leaderCd > 0 ? 'rgba(245,239,226,.35)' : '#F2A33C'),
      crownFill: S.leaderOn ? '#1A1105' : (S.leaderCd > 0 ? 'rgba(245,239,226,.3)' : '#F2A33C'),
      crownBg: S.leaderOn ? '#F2A33C' : '#201C13',
      crownFrame: S.leaderOn ? '' : 'box-shadow: inset 0 0 0 1px rgba(242,163,60,.3);',
      c1: S.sel.length >= 1 ? '#F2A33C' : FAINT,
      c2: S.sel.length >= 2 ? '#F2A33C' : FAINT,
      c3: S.sel.length >= 3 ? '#F2A33C' : FAINT,
      navEquipe: () => this.nav('EQUIPE'),
      navInvoc: () => this.nav('INVOCAR'),
      navLoja: () => this.nav('LOJA'),
      navFases: () => this.nav('FASES'),
      toast: S.toast, toastOn: S.toastOn, toastCol: tones[S.toastTone] || '#F2A33C'
    };
  }
}
</script>
</body>
</html>
