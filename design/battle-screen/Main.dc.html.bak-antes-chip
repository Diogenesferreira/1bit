<body>
<x-dc>
<helmet>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Martian+Mono:wght@300;400;500;600&display=swap">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Instrument Sans', 'Segoe UI', system-ui, sans-serif; }
    a { color: #F2A33C; } a:hover { color: #FFC97A; }
    .mono { font-family: 'Martian Mono', ui-monospace, 'Consolas', monospace; font-variant-numeric: tabular-nums; }
    .tick { font-size: 7px; font-weight: 400; letter-spacing: .5px; text-transform: uppercase; }
    .track { position: relative; background: rgba(6,10,14,.72); overflow: hidden; border-radius: 1px; }
    .mask { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, transparent 0 5px, rgba(6,10,14,.85) 5px 7px); }
    .maskui { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, transparent 0 5px, #16130D 5px 7px); }
    .vrule { width: 1px; background: repeating-linear-gradient(180deg, rgba(242,163,60,.3) 0 3px, transparent 3px 6px); }
    .plate { position: absolute; border-radius: 4px; background: linear-gradient(180deg, #1B2833, #0A1119); box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 0 0 1px rgba(0,0,0,.7), 0 2px 4px rgba(0,0,0,.55); padding: 2px 3px 3px; }
    .r1 { display: flex; align-items: center; gap: 4px; height: 14px; }
    .r2 { display: flex; align-items: center; gap: 3px; margin-top: 2px; }
    .badge { width: 14px; height: 14px; border-radius: 50%; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 1.5px rgba(255,255,255,.6); }
    .lv { font-size: 9px; font-weight: 700; color: #fff; text-shadow: 0 1px 0 #000, 0 0 3px rgba(0,0,0,.9); letter-spacing: -.2px; }
    .lv em { font-style: normal; font-size: 6.5px; opacity: .7; margin-right: 1px; }
    .sk { font-size: 5.5px; font-weight: 700; letter-spacing: .4px; text-shadow: 0 1px 0 #000; }
    .bar { position: relative; flex: 1 1 auto; height: 6px; background: #060A0E; border-radius: 2px; box-shadow: inset 0 1px 2px rgba(0,0,0,.9), 0 0 0 1px rgba(255,255,255,.24); overflow: hidden; }
    .bar i { display: block; height: 100%; }
    .bar u { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, transparent 0 8px, rgba(6,10,14,.95) 8px 10px); }
    .card { position: relative; border-radius: 9px; overflow: hidden; border: 0; padding: 0; cursor: pointer; aspect-ratio: 76 / 88; transition: transform .12s, box-shadow .12s; }
    .tex { position: absolute; inset: 0; background-image: radial-gradient(circle at 82% 14%, rgba(255,255,255,.14) 0 1.1px, transparent 1.2px), repeating-linear-gradient(52deg, rgba(255,255,255,.05) 0 1px, transparent 1px 7px); background-size: 9px 9px, auto; }
    .emb { position: absolute; left: 50%; top: 47%; transform: translate(-50%,-50%); filter: drop-shadow(0 2px 2px rgba(0,0,0,.55)); }
    .chip { position: absolute; transform: translateX(-50%); display: flex; align-items: center; gap: 3px; height: 14px; padding: 0 5px 0 2px; border-radius: 7px; background: rgba(12,14,16,.88); box-shadow: 0 0 0 1px rgba(255,255,255,.18), 0 2px 4px rgba(0,0,0,.5); white-space: nowrap; pointer-events: none; }
    .dot { width: 11px; height: 11px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 1px rgba(255,255,255,.55); }
    .tn { display: inline-flex; align-items: center; gap: 1.5px; margin-left: 2px; font-family: 'Martian Mono', monospace; font-size: 7px; font-weight: 600; }
    .tn i { display: inline-block; width: 5px; height: 2.5px; border-radius: 1px; }
    .tn b { margin-left: 2px; font-weight: 600; }
    .mini { position: absolute; transform: translateX(-50%); display: flex; align-items: center; gap: 3px; pointer-events: none; }
    .mini .mb { flex: 1 1 auto; height: 3px; border-radius: 2px; background: rgba(8,10,12,.78); overflow: hidden; box-shadow: 0 0 0 1px rgba(0,0,0,.35); }
    .mini .mb i { display: block; height: 100%; }
    @keyframes fast { 0%,100% { opacity: 1; } 50% { opacity: .5; } }
    @keyframes ret { 0%,100% { opacity: .6; } 50% { opacity: 1; } }
    @keyframes pop { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
  </style>
</helmet>

<div style="width: 512px; height: 800px; position: relative; overflow: hidden; background: #16130D; color: #F5EFE2;">

  <svg width="0" height="0" style="position: absolute;" aria-hidden="true"><defs>
    <linearGradient id="gDragon" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFFFFF"/><stop offset="1" stop-color="#FF9E88"/></linearGradient>
    <linearGradient id="gKnight" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFFFFF"/><stop offset="1" stop-color="#9CCBF5"/></linearGradient>
    <linearGradient id="gNature" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFFFFF"/><stop offset="1" stop-color="#9BE79B"/></linearGradient>
    <linearGradient id="gLight"  x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFFFFF"/><stop offset="1" stop-color="#FFDE7A"/></linearGradient>
    <linearGradient id="gDark"   x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFFFFF"/><stop offset="1" stop-color="#C9A3F5"/></linearGradient>
    <linearGradient id="gCaps"   x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFFBF0"/><stop offset="1" stop-color="#E3C58C"/></linearGradient>
    <linearGradient id="gWild"   x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFFFFF"/><stop offset="1" stop-color="#CFCFE4"/></linearGradient>
    <linearGradient id="pSky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1F6C96"/><stop offset=".45" stop-color="#4FA3C4"/><stop offset="1" stop-color="#A6DCE2"/></linearGradient>
    <linearGradient id="pSea" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1B7FA6"/><stop offset="1" stop-color="#39B2C4"/></linearGradient>
    <linearGradient id="pGnd" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7C9448"/><stop offset="1" stop-color="#4E6634"/></linearGradient>
  </defs></svg>

  <!-- ============ CABEÇALHO ============ -->
  <div style="height: 66px; display: flex; align-items: center; gap: 12px; padding: 0 16px;">
    <div style="position: relative; width: 42px; height: 42px; flex: 0 0 auto;">
      <img src="avatar.png" style="width: 42px; height: 42px; border-radius: 12px; object-fit: cover; display: block;">
      <span style="position: absolute; inset: 0; border-radius: 12px; box-shadow: inset 0 0 0 1px rgba(242,163,60,.55);"></span>
      <span style="position: absolute; left: -3px; top: -3px; width: 9px; height: 9px; border-left: 1.5px solid #F2A33C; border-top: 1.5px solid #F2A33C;"></span>
      <span style="position: absolute; right: -3px; bottom: -3px; width: 9px; height: 9px; border-right: 1.5px solid #F2A33C; border-bottom: 1.5px solid #F2A33C;"></span>
    </div>
    <div style="flex: 1 1 auto; min-width: 0;">
      <div style="display: flex; align-items: baseline; gap: 8px;">
        <span style="font-size: 15px; font-weight: 700; letter-spacing: -.2px;">Jinsa</span>
        <span class="mono tick" style="color: #F2A33C;">TAMER · LV38</span>
      </div>
      <div style="display: flex; align-items: center; gap: 7px; margin-top: 5px;">
        <div class="track" style="width: 148px; height: 4px; background: rgba(245,239,226,.1);"><div style="width: 51%; height: 100%; background: #F2A33C;"></div><span class="maskui"></span></div>
        <span class="mono" style="font-size: 8px; color: rgba(245,239,226,.45);">6120/12000</span>
      </div>
    </div>
    <div style="flex: 0 0 auto; display: flex; align-items: center; gap: 9px;">
      <span style="width: 6px; height: 6px; border-radius: 50%; background: #6FE3B8; box-shadow: 0 0 8px rgba(111,227,184,.8);"></span>
      <span class="mono tick" style="color: rgba(245,239,226,.4);">SYNC</span>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="rgba(245,239,226,.55)" stroke-width="1.8" stroke-linecap="round"><path d="M5 7h14"/><path d="M5 12h14"/><path d="M5 17h14"/></svg>
    </div>
  </div>

  <!-- ============ FAIXA DE INSTRUMENTOS ============ -->
  <div style="height: 46px; background: #201C13; border-top: 1px solid rgba(242,163,60,.2); border-bottom: 1px solid rgba(242,163,60,.2); display: flex; align-items: center;">
    <div style="flex: 1 1 0; padding: 0 14px;">
      <div style="display: flex; align-items: center; gap: 5px;">
        <svg viewBox="0 0 24 24" width="9" height="9" fill="none" stroke="#F2A33C" stroke-width="2.6"><circle cx="12" cy="12" r="9"/></svg>
        <span class="mono tick" style="color: rgba(245,239,226,.45);">BITS</span>
      </div>
      <div class="mono" style="font-size: 12.5px; font-weight: 600; margin-top: 3px; letter-spacing: -.6px;">12.845.900</div>
    </div>
    <div class="vrule" style="height: 30px;"></div>
    <div style="flex: 1 1 0; padding: 0 14px;">
      <div style="display: flex; align-items: center; gap: 5px;">
        <svg viewBox="0 0 24 24" width="9" height="9" fill="#B78BFF" stroke="none"><path d="M12 2l8 7-8 13-8-13z"/></svg>
        <span class="mono tick" style="color: rgba(245,239,226,.45);">GEMAS</span>
      </div>
      <div class="mono" style="font-size: 12.5px; font-weight: 600; margin-top: 3px; letter-spacing: -.6px;">128.400</div>
    </div>
    <div class="vrule" style="height: 30px;"></div>
    <div style="flex: 1 1 0; padding: 0 14px;">
      <div style="display: flex; align-items: center; gap: 5px;">
        <svg viewBox="0 0 24 24" width="9" height="9" fill="#6FE3B8" stroke="none"><path d="M13 2 4 14h6l-1 8 9-12h-6z"/></svg>
        <span class="mono tick" style="color: rgba(245,239,226,.45);">ENERGIA</span>
        <span class="mono tick" style="color: rgba(111,227,184,.7); margin-left: auto;">+04:12</span>
      </div>
      <div class="mono" style="font-size: 12.5px; font-weight: 600; margin-top: 3px; letter-spacing: -.6px;">092<span style="color: rgba(245,239,226,.35);">/100</span></div>
    </div>
  </div>

  <!-- ============ VISOR ============ -->
  <div style="position: absolute; left: 12px; top: 116px; width: 488px; height: 368px; border-radius: 16px; overflow: hidden; box-shadow: inset 0 0 0 1px rgba(242,163,60,.28), 0 10px 28px rgba(0,0,0,.55);">

    <!-- CAMADA 1 · CENÁRIO — recorte x24–1000 / y232–968 da arte 1024×1600 (2×) -->
    <sc-if value="{{bgTropical}}" hint-placeholder-val="{{ true }}"><img src="bg-tropical.webp" style="position: absolute; inset: 0; width: 100%; height: 100%; display: block; object-fit: cover;"></sc-if>
    <sc-if value="{{bgDeserto}}" hint-placeholder-val="{{ false }}"><img src="bg-deserto.webp" style="position: absolute; inset: 0; width: 100%; height: 100%; display: block; object-fit: cover;"></sc-if>
    <sc-if value="{{bgVetor}}" hint-placeholder-val="{{ false }}"><svg viewBox="0 0 488 368" preserveAspectRatio="xMidYMid slice" style="position: absolute; inset: 0; width: 100%; height: 100%; display: block;">
      <rect width="488" height="368" fill="url(#pSky)"/>
      <g fill="#17546B" opacity=".9">
        <path d="M0 206 L38 158 L66 180 L102 138 L138 174 L168 156 L204 204 Z"/>
        <path d="M286 204 L318 152 L346 174 L382 132 L414 168 L442 150 L488 192 L488 204 Z"/>
      </g>
      <g fill="#0F4053">
        <path d="M0 210 L34 184 L74 204 L112 182 L154 208 L186 194 L214 212 L0 216 Z"/>
        <path d="M262 212 L300 190 L336 208 L372 186 L410 206 L444 190 L488 210 L488 216 Z"/>
      </g>
      <g fill="#CFEFF2" opacity=".55">
        <path d="M104 142 L110 142 L112 200 L102 200 Z"/><path d="M382 136 L388 136 L390 196 L380 196 Z"/>
      </g>
      <rect y="208" width="488" height="42" fill="url(#pSea)"/>
      <g fill="#BEF0F4" opacity=".45">
        <path d="M12 224 h58 v2.5 h-58 Z"/><path d="M120 232 h44 v2.5 h-44 Z"/><path d="M226 220 h70 v2.5 h-70 Z"/>
        <path d="M330 236 h52 v2.5 h-52 Z"/><path d="M408 226 h62 v2.5 h-62 Z"/><path d="M60 240 h40 v2.5 h-40 Z"/>
      </g>
      <path d="M0 246 L488 240 L488 268 L0 276 Z" fill="#D3BE82"/>
      <path d="M0 268 L488 262 L488 368 L0 368 Z" fill="url(#pGnd)"/>
      <g fill="#425A2C" opacity=".45">
        <ellipse cx="96" cy="300" rx="52" ry="10"/><ellipse cx="330" cy="288" rx="44" ry="9"/><ellipse cx="220" cy="344" rx="66" ry="12"/>
      </g>
      <g stroke="#8CEBF2" stroke-width=".7" opacity=".16" fill="none">
        <path d="M244 262 L-40 368"/><path d="M244 262 L58 368"/><path d="M244 262 L152 368"/><path d="M244 262 L244 368"/>
        <path d="M244 262 L336 368"/><path d="M244 262 L430 368"/><path d="M244 262 L528 368"/>
        <path d="M0 288 L488 284"/><path d="M0 312 L488 306"/><path d="M0 344 L488 336"/>
      </g>
      <g fill="#2C3F49">
        <path d="M10 300 L14 214 L34 206 L46 218 L44 302 Z"/>
        <path d="M446 292 L450 210 L470 202 L482 214 L480 296 Z"/>
      </g>
      <g stroke="#8CEBF2" stroke-width="1.4" opacity=".55" fill="none">
        <path d="M20 288 L20 250 L34 240"/><path d="M28 296 L28 264 L38 256"/>
        <path d="M456 282 L456 246 L468 238"/><path d="M466 290 L466 260 L474 252"/>
      </g>
      <g fill="#123A2A" opacity=".92">
        <path d="M0 0 L64 0 C52 22 30 34 6 38 C26 30 40 16 44 0 L18 0 C14 14 6 24 0 28 Z"/>
        <path d="M488 0 L424 0 C436 24 458 36 484 40 C462 32 448 18 444 0 L470 0 C474 14 482 24 488 28 Z"/>
      </g>
      <g fill="#8CEBF2" opacity=".3">
        <rect x="150" y="96" width="5" height="5"/><rect x="322" y="72" width="4" height="4"/><rect x="76" y="140" width="4" height="4"/>
        <rect x="410" y="112" width="5" height="5"/><rect x="252" y="52" width="4" height="4"/><rect x="196" y="160" width="3" height="3"/>
      </g>
    </svg></sc-if>

    <!-- CAMADA 2 · PERSONAGENS — PNG 256×256 (chefe 512), pé em (128, 248) -->
    <sc-for list="{{figs}}" as="g" hint-placeholder-count="8">
      <div style="position: absolute; left: {{g.x}}; top: {{g.top}}; width: {{g.w}}; height: {{g.w}}; transform: translateX(-50%); opacity: {{g.op}}; filter: {{g.fx}};">
        <sc-if value="{{g.plain}}" hint-placeholder-val="{{ false }}"><span style="position: absolute; left: 50%; top: 97%; transform: translate(-50%,-50%); width: 64%; height: 10%; border-radius: 50%; background: rgba(18,24,12,.42);"></span></sc-if>
        <sc-if value="{{g.ring}}" hint-placeholder-val="{{ true }}"><svg style="position: absolute; left: {{g.rl}}; top: {{g.rt}}; width: {{g.rw}}; height: {{g.rh}}; overflow: visible; filter: {{g.rglow}};">
          <ellipse cx="{{g.rcx}}" cy="{{g.rcy}}" rx="{{g.rx}}" ry="{{g.ry}}" fill="rgba(10,14,10,.38)" stroke="rgba(8,10,12,.75)" stroke-width="5"></ellipse>
          <ellipse cx="{{g.rcx}}" cy="{{g.rcy}}" rx="{{g.rx}}" ry="{{g.ry}}" fill="none" stroke="{{g.rcol}}" stroke-width="3.2" pathLength="100" stroke-dasharray="{{g.dash}}" style="transition: stroke-dasharray .3s;"></ellipse>
          <ellipse cx="{{g.rcx}}" cy="{{g.rcy}}" rx="{{g.rx}}" ry="{{g.ry}}" fill="none" stroke="rgba(8,10,12,.9)" stroke-width="3.6" pathLength="100" stroke-dasharray=".7 4.3"></ellipse>
        </svg></sc-if>
        <sc-if value="{{g.is_A1}}" hint-placeholder-val="{{ false }}"><img src="chr-a1.webp" style="position: absolute; inset: 0; width: 100%; height: 100%; display: block; image-rendering: auto;"></sc-if>
        <sc-if value="{{g.is_A2}}" hint-placeholder-val="{{ false }}"><img src="chr-a2.webp" style="position: absolute; inset: 0; width: 100%; height: 100%; display: block; image-rendering: auto;"></sc-if>
        <sc-if value="{{g.is_A3}}" hint-placeholder-val="{{ false }}"><img src="chr-a3.webp" style="position: absolute; inset: 0; width: 100%; height: 100%; display: block; image-rendering: auto;"></sc-if>
        <sc-if value="{{g.is_A4}}" hint-placeholder-val="{{ false }}"><img src="chr-a4.webp" style="position: absolute; inset: 0; width: 100%; height: 100%; display: block; image-rendering: auto;"></sc-if>
        <sc-if value="{{g.is_A5}}" hint-placeholder-val="{{ false }}"><img src="chr-a5.webp" style="position: absolute; inset: 0; width: 100%; height: 100%; display: block; image-rendering: auto;"></sc-if>
        <sc-if value="{{g.is_E1}}" hint-placeholder-val="{{ false }}"><img src="chr-boss.webp" style="position: absolute; inset: 0; width: 100%; height: 100%; display: block; image-rendering: auto;"></sc-if>
        <sc-if value="{{g.is_E2}}" hint-placeholder-val="{{ false }}"><img src="chr-e2.webp" style="position: absolute; inset: 0; width: 100%; height: 100%; display: block; image-rendering: auto;"></sc-if>
        <sc-if value="{{g.is_E3}}" hint-placeholder-val="{{ false }}"><img src="chr-e3.webp" style="position: absolute; inset: 0; width: 100%; height: 100%; display: block; image-rendering: auto;"></sc-if>
        <sc-if value="{{g.is_BOSS}}" hint-placeholder-val="{{ false }}"><img src="chr-boss.webp" style="position: absolute; inset: 0; width: 100%; height: 100%; display: block; image-rendering: auto;"></sc-if>
      </div>
    </sc-for>

    <!-- CAMADA 3 · PELÍCULA (sempre por cima de cenário + personagens) -->
    <div style="position: absolute; inset: 0; background: repeating-linear-gradient(180deg, rgba(0,0,0,.15) 0 1px, transparent 1px 3px);"></div>
    <div style="position: absolute; inset: 0; background: radial-gradient(115% 88% at 50% 42%, rgba(0,0,0,0) 42%, rgba(22,19,13,.62) 100%);"></div>

    <!-- CAMADA 4 · HUD -->
    <span style="position: absolute; left: 8px; top: 8px; width: 16px; height: 16px; border-left: 1.5px solid rgba(242,163,60,.75); border-top: 1.5px solid rgba(242,163,60,.75);"></span>
    <span style="position: absolute; right: 8px; top: 8px; width: 16px; height: 16px; border-right: 1.5px solid rgba(242,163,60,.75); border-top: 1.5px solid rgba(242,163,60,.75);"></span>
    <span style="position: absolute; left: 8px; bottom: 8px; width: 16px; height: 16px; border-left: 1.5px solid rgba(242,163,60,.75); border-bottom: 1.5px solid rgba(242,163,60,.75);"></span>
    <span style="position: absolute; right: 8px; bottom: 8px; width: 16px; height: 16px; border-right: 1.5px solid rgba(242,163,60,.75); border-bottom: 1.5px solid rgba(242,163,60,.75);"></span>
    <span class="mono tick" style="position: absolute; left: 30px; top: 11px; color: rgba(242,163,60,.95); text-shadow: 0 1px 4px rgba(0,0,0,.9);">SETOR 03 · ILHA DIGITAL</span>
    <div style="position: absolute; right: 30px; top: 10px; text-align: right; line-height: 1.7;">
      <div class="mono tick" style="color: rgba(245,239,226,.7); text-shadow: 0 1px 4px rgba(0,0,0,.9);">A.D. 2003</div>
      <div class="mono tick" style="color: #F2A33C; text-shadow: 0 1px 4px rgba(0,0,0,.9);">ROUND {{round}}/{{roundMax}}</div>
    </div>

    <!-- mira sobre o alvo -->
    <div style="position: absolute; left: {{aimX}}; top: {{aimY}}; transform: translate(-50%,-50%); width: {{aimS}}; height: {{aimS}}; animation: ret 1.4s ease-in-out infinite;">
      <span style="position: absolute; left: 0; top: 0; width: 17px; height: 17px; border-left: 1.5px solid #FF6B4A; border-top: 1.5px solid #FF6B4A;"></span>
      <span style="position: absolute; right: 0; top: 0; width: 17px; height: 17px; border-right: 1.5px solid #FF6B4A; border-top: 1.5px solid #FF6B4A;"></span>
      <span style="position: absolute; left: 0; bottom: 0; width: 17px; height: 17px; border-left: 1.5px solid #FF6B4A; border-bottom: 1.5px solid #FF6B4A;"></span>
      <span style="position: absolute; right: 0; bottom: 0; width: 17px; height: 17px; border-right: 1.5px solid #FF6B4A; border-bottom: 1.5px solid #FF6B4A;"></span>
    </div>

    <!-- TOQUE: area clicavel sobre cada personagem -->
    <sc-for list="{{enemies}}" as="e" hint-placeholder-count="3">
      <button type="button" onClick="{{e.pick}}" style="position: absolute; left: {{e.x}}; top: {{e.top}}; width: {{e.hitW}}; height: {{e.hitH}}; transform: translateX(-50%); background: transparent; border: 0; padding: 0; cursor: pointer; display: {{e.show}};"></button>
    </sc-for>
    <sc-for list="{{allies}}" as="a" hint-placeholder-count="5">
      <button type="button" onClick="{{a.pick}}" style="position: absolute; left: {{a.x}}; top: {{a.top}}; width: {{a.hitW}}; height: {{a.hitH}}; transform: translateX(-50%); background: transparent; border: 0; padding: 0; cursor: pointer;"></button>
    </sc-for>

    <!-- INDICADOR · ANEL: chip de elemento + LV (+ turno do inimigo) na frente do anel do chao -->
    <sc-if value="{{indAnel}}" hint-placeholder-val="{{ true }}">
      <sc-for list="{{enemies}}" as="e" hint-placeholder-count="3">
        <span class="chip" style="left: {{e.x}}; top: {{e.chipTop}}; display: {{e.showFlex}}; {{e.chipFrame}}">
          <span class="dot" style="background: {{e.badge}};"><svg viewBox="0 0 24 24" width="7" height="7" fill="none" stroke="rgba(8,14,20,.9)" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="{{e.icon}}"></path></svg></span>
          <span class="lv"><em>LV</em>{{e.lv}}</span>
          <span class="tn" style="color: {{e.tcol}}; animation: {{e.tanim}};"><i style="background: {{e.s1}};"></i><i style="background: {{e.s2}};"></i><i style="background: {{e.s3}};"></i><b>{{e.atk}}</b></span>
        </span>
      </sc-for>
      <sc-for list="{{allies}}" as="a" hint-placeholder-count="5">
